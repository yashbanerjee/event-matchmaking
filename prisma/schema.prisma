generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, btree_gist]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OrganizationType {
  PLATFORM
  COMPANY
  VENDOR
}

enum OrganizationStatus {
  DRAFT
  ACTIVE
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  SENT
  DELIVERED
  ACCEPTED
  EXPIRED
  REVOKED
  FAILED
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  PHONE
  NUMBER
  CURRENCY
  PERCENTAGE
  SINGLE_SELECT
  MULTI_SELECT
  RADIO
  CHECKBOX
  DATE
  DATE_RANGE
  TIME
  COUNTRY_REGION
  WEBSITE
  FILE
  MULTI_FILE
  IMAGE
  BOOLEAN
  RATING
  TAGS
  REPEATABLE_GROUP
  CONDITIONAL_SECTION
  READ_ONLY
}

enum SensitivityClass {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_INFO
}

enum CorrectionStatus {
  OPEN
  RESOLVED
  SUPERSEDED
}

enum MatchmakingRunStatus {
  DRAFT
  QUEUED
  PROCESSING
  PREVIEW_READY
  PUBLISHED
  COMPLETED
  FAILED
  CANCELLED
}

enum MeetingStatus {
  PROPOSED
  PUBLISHED
  AWAITING_CONFIRMATION
  CONFIRMED
  RESCHEDULE_REQUESTED
  RESCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MeetingMode {
  VIRTUAL
  IN_PERSON
  HYBRID
}

enum MeetingRequestStatus {
  PENDING
  INTEREST_ACCEPTED
  AWAITING_CONFIRMATION
  SCHEDULED
  DECLINED
  CANCELLED
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum FeedbackOutcome {
  SUCCESSFUL_DISCUSSION
  INTERESTED_IN_PARTNERSHIP
  FOLLOW_UP_REQUIRED
  PROPOSAL_REQUESTED
  NEGOTIATION_IN_PROGRESS
  NOT_A_FIT
  NO_SHOW
  CANCELLED
  CUSTOM
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTERED
  CANCELLED
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
  FAILED
}

// ─── Identity & RBAC ─────────────────────────────────────────────────────────

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  status       UserStatus @default(INVITED)
  timeZone     String     @default("UTC")
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles                 UserRole[]
  memberships           OrganizationMember[]
  invitationsCreated    Invitation[]           @relation("InvitationCreator")
  invitationsAccepted   Invitation[]           @relation("InvitationAcceptor")
  refreshTokens         RefreshToken[]
  formSubmissions       FormSubmission[]
  submissionCorrections SubmissionCorrection[] @relation("CorrectionRequester")
  meetingParticipations MeetingParticipant[]
  meetingConfirmations  MeetingConfirmation[]
  feedbacks             MeetingFeedback[]
  followUpsAssigned     FollowUpAction[]       @relation("FollowUpAssignee")
  followUpsCreated      FollowUpAction[]       @relation("FollowUpCreator")
  auditLogs             AuditLog[]
  passwordResetTokens   PasswordResetToken[]
  pushSubscriptions     PushSubscription[]

  @@index([status])
  @@map("users")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
  invitations Invitation[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Organizations ───────────────────────────────────────────────────────────

model Organization {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        OrganizationType
  code        String             @unique
  name        String
  status      OrganizationStatus @default(DRAFT)
  industry    String?
  sizeBand    String?
  country     String?
  region      String?
  address     String?
  website     String?
  timeZone    String             @default("UTC")
  customAttrs Json               @default("{}")
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  members             OrganizationMember[]
  company             Company?
  vendor              Vendor?
  invitations         Invitation[]
  formAssignments     FormAssignment[]
  formSubmissions     FormSubmission[]
  documents           Document[]
  meetingsAsCompany   Meeting[]            @relation("MeetingCompany")
  meetingsAsVendor    Meeting[]            @relation("MeetingVendor")
  meetingRequestsSent     MeetingRequest[] @relation("MeetingRequestFrom")
  meetingRequestsReceived MeetingRequest[] @relation("MeetingRequestTo")
  feedbacks           MeetingFeedback[]
  followUps           FollowUpAction[]
  availabilityWindows AvailabilityWindow[]

  @@index([type, status])
  @@index([name])
  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  title          String?
  isPrimary      Boolean  @default(false)
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Company {
  organizationId       String   @id @db.Uuid
  preferredCategories  String[] @default([])
  requiredCapabilities String[] @default([])
  commercialPrefs      Json     @default("{}")
  verificationStatus   String   @default("UNVERIFIED")
  /// INVITED | WAITING_FOR_REVIEW | IN_REVIEW | VERIFIED | RESEND_FOR_IMPROVEMENTS
  approvalStatus       String   @default("INVITED")
  matchingEligible     Boolean  @default(false)
  /// Shown as an admin suggestion on vendor home recommendations.
  featured             Boolean  @default(false)
  profileVersion       Int      @default(0)
  normalizedProfile    Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([matchingEligible, approvalStatus])
  @@index([featured, matchingEligible])
  @@map("companies")
}

model Vendor {
  organizationId     String   @id @db.Uuid
  displayName        String?
  categories         String[] @default([])
  services           String[] @default([])
  capabilities       String[] @default([])
  operatingRegions   String[] @default([])
  capacityPerDay     Int?
  commercialPrefs    Json     @default("{}")
  verificationStatus String   @default("UNVERIFIED")
  /// INVITED | WAITING_FOR_REVIEW | IN_REVIEW | VERIFIED | RESEND_FOR_IMPROVEMENTS
  approvalStatus     String   @default("INVITED")
  onboardingComplete Boolean  @default(false)
  matchingEligible   Boolean  @default(false)
  /// Shown as an admin suggestion on company/delegate home recommendations.
  featured           Boolean  @default(false)
  profileVersion     Int      @default(0)
  normalizedProfile  Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([matchingEligible, approvalStatus])
  @@index([featured, matchingEligible])
  @@map("vendors")
}

// ─── Invitations ─────────────────────────────────────────────────────────────

model Invitation {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String
  organizationId       String           @db.Uuid
  roleId               String           @db.Uuid
  onboardingWorkflowId String?          @db.Uuid
  tokenHash            String           @unique
  status               InvitationStatus @default(PENDING)
  expiresAt            DateTime
  createdById          String           @db.Uuid
  acceptedById         String?          @db.Uuid
  acceptedAt           DateTime?
  deliveryHistory      Json             @default("[]")
  idempotencyKey       String           @unique
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  role               Role                @relation(fields: [roleId], references: [id])
  onboardingWorkflow OnboardingWorkflow? @relation(fields: [onboardingWorkflowId], references: [id])
  createdBy          User                @relation("InvitationCreator", fields: [createdById], references: [id])
  acceptedBy         User?               @relation("InvitationAcceptor", fields: [acceptedById], references: [id])

  @@index([email, status])
  @@index([organizationId])
  @@map("invitations")
}

// ─── Onboarding & Forms ──────────────────────────────────────────────────────

model OnboardingWorkflow {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  targetType  OrganizationType
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions    WorkflowVersion[]
  invitations Invitation[]

  @@map("onboarding_workflows")
}

model WorkflowVersion {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId  String     @db.Uuid
  version     Int
  status      FormStatus @default(DRAFT)
  definition  Json       @default("{}")
  publishedAt DateTime?
  createdAt   DateTime   @default(now())

  workflow OnboardingWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@map("workflow_versions")
}

model Form {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String             @unique
  name        String
  description String?
  targetType  OrganizationType?
  isTemplate  Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  versions    FormVersion[]
  assignments FormAssignment[]

  @@map("forms")
}

model FormVersion {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formId      String     @db.Uuid
  version     Int
  status      FormStatus @default(DRAFT)
  schemaHash  String?
  schemaJson  Json?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())

  form        Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  fields      FormField[]
  assignments FormAssignment[]
  submissions FormSubmission[]

  @@unique([formId, version])
  @@map("form_versions")
}

model FormField {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formVersionId   String            @db.Uuid
  fieldKey        String
  label           String
  description     String?
  fieldType       FieldType
  required        Boolean           @default(false)
  defaultValue    Json?
  validationRules Json              @default("{}")
  displayOrder    Int               @default(0)
  conditionalLogic Json             @default("{}")
  options         Json              @default("[]")
  fileRestrictions Json             @default("{}")
  sensitivity     SensitivityClass  @default(INTERNAL)
  permissions     Json              @default("{}")
  createdAt       DateTime          @default(now())

  formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)

  @@unique([formVersionId, fieldKey])
  @@index([formVersionId, displayOrder])
  @@map("form_fields")
}

model FormAssignment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formId         String   @db.Uuid
  formVersionId  String   @db.Uuid
  organizationId String?  @db.Uuid
  userId         String?  @db.Uuid
  assignedAt     DateTime @default(now())
  dueAt          DateTime?
  isRequired     Boolean  @default(true)

  form         Form          @relation(fields: [formId], references: [id])
  formVersion  FormVersion   @relation(fields: [formVersionId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([formVersionId])
  @@map("form_assignments")
}

model FormSubmission {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formVersionId  String           @db.Uuid
  organizationId String           @db.Uuid
  submittedById  String           @db.Uuid
  status         SubmissionStatus @default(DRAFT)
  responses      Json             @default("{}")
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewNotes    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  formVersion  FormVersion             @relation(fields: [formVersionId], references: [id])
  organization Organization            @relation(fields: [organizationId], references: [id])
  submittedBy  User                    @relation(fields: [submittedById], references: [id])
  corrections  SubmissionCorrection[]

  @@index([organizationId, status])
  @@index([formVersionId])
  @@map("form_submissions")
}

model SubmissionCorrection {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId    String           @db.Uuid
  status          CorrectionStatus @default(OPEN)
  requestedById   String           @db.Uuid
  accessTokenHash String?          @unique
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?

  submission  FormSubmission               @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  requestedBy User                         @relation("CorrectionRequester", fields: [requestedById], references: [id])
  fields      SubmissionCorrectionField[]

  @@index([submissionId, status])
  @@map("submission_corrections")
}

model SubmissionCorrectionField {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correctionId String @db.Uuid
  fieldId      String
  note         String

  correction SubmissionCorrection @relation(fields: [correctionId], references: [id], onDelete: Cascade)

  @@unique([correctionId, fieldId])
  @@index([correctionId])
  @@map("submission_correction_fields")
}

// ─── Availability ────────────────────────────────────────────────────────────

model AvailabilityWindow {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  dayOfWeek      Int?
  startDate      DateTime? @db.Date
  endDate        DateTime? @db.Date
  startTime      String
  endTime        String
  timeZone       String   @default("UTC")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("availability_windows")
}

// ─── Matchmaking ─────────────────────────────────────────────────────────────

model MatchingRule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions MatchingRuleVersion[]
  runs     MatchmakingRun[]

  @@map("matching_rules")
}

model MatchingRuleVersion {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId           String   @db.Uuid
  version          Int
  weights          Json
  minScore         Float    @default(40)
  hardConstraints  Json     @default("{}")
  publishedAt      DateTime?
  createdAt        DateTime @default(now())

  rule MatchingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
  @@map("matching_rule_versions")
}

model MatchmakingRun {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchingRuleId       String                @db.Uuid
  matchingRuleVersion  Int
  scheduleDate         DateTime              @db.Date
  timeZone             String                @default("UTC")
  status               MatchmakingRunStatus  @default(DRAFT)
  config               Json                  @default("{}")
  idempotencyKey       String                @unique
  errorMessage         String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdById          String?               @db.Uuid
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  matchingRule    MatchingRule     @relation(fields: [matchingRuleId], references: [id])
  candidates      MatchCandidate[]
  matches         Match[]
  scheduleVersions ScheduleVersion[]

  @@index([status, scheduleDate])
  @@map("matchmaking_runs")
}

model MatchCandidate {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId            String   @db.Uuid
  companyOrgId     String   @db.Uuid
  vendorOrgId      String   @db.Uuid
  totalScore       Float
  scoreBreakdown   Json
  explanation      String
  eligible         Boolean
  ineligibilityReasons String[] @default([])
  companyProfileVersion Int
  vendorProfileVersion  Int
  createdAt        DateTime @default(now())

  run MatchmakingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, companyOrgId, vendorOrgId])
  @@index([runId, eligible, totalScore])
  @@map("match_candidates")
}

model Match {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId         String   @db.Uuid
  companyOrgId  String   @db.Uuid
  vendorOrgId   String   @db.Uuid
  totalScore    Float
  scoreBreakdown Json
  explanation   String
  isManual      Boolean  @default(false)
  overrideReason String?
  createdAt     DateTime @default(now())

  run     MatchmakingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  meeting Meeting?

  @@unique([runId, companyOrgId, vendorOrgId])
  @@map("matches")
}

// ─── Places (on-site tables / rooms) ─────────────────────────────────────────

model Place {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  code        String   @unique
  description String?
  capacity    Int?
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meetings        Meeting[]
  meetingRequests MeetingRequest[]

  @@index([isActive, name])
  @@map("places")
}

model MeetingRequest {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromOrgId        String               @db.Uuid
  toOrgId          String               @db.Uuid
  requestedById    String               @db.Uuid
  status           MeetingRequestStatus @default(PENDING)
  message          String?
  proposedStartsAt DateTime?
  proposedEndsAt   DateTime?
  proposedByOrgId  String?              @db.Uuid
  placeId          String?              @db.Uuid
  meetingId        String?              @unique @db.Uuid
  declineReason    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  fromOrg Organization @relation("MeetingRequestFrom", fields: [fromOrgId], references: [id], onDelete: Cascade)
  toOrg   Organization @relation("MeetingRequestTo", fields: [toOrgId], references: [id], onDelete: Cascade)
  place   Place?       @relation(fields: [placeId], references: [id])
  meeting Meeting?     @relation(fields: [meetingId], references: [id])

  @@index([fromOrgId, status])
  @@index([toOrgId, status])
  @@index([status, createdAt])
  @@map("meeting_requests")
}

// ─── Scheduling ──────────────────────────────────────────────────────────────

model ScheduleVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId         String   @db.Uuid
  version       Int
  status        MatchmakingRunStatus @default(DRAFT)
  publishedAt   DateTime?
  publishedById String?  @db.Uuid
  config        Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  run     MatchmakingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  slots   MeetingSlot[]
  meetings Meeting[]

  @@unique([runId, version])
  @@map("schedule_versions")
}

model MeetingSlot {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleVersionId String   @db.Uuid
  slotIndex         Int
  startsAt          DateTime
  endsAt            DateTime
  timeZone          String   @default("UTC")
  isBreak           Boolean  @default(false)
  capacity          Int?
  createdAt         DateTime @default(now())

  scheduleVersion ScheduleVersion @relation(fields: [scheduleVersionId], references: [id], onDelete: Cascade)
  meetings        Meeting[]

  @@unique([scheduleVersionId, slotIndex])
  @@index([startsAt, endsAt])
  @@map("meeting_slots")
}

model Meeting {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleVersionId String?       @db.Uuid
  slotId            String?       @db.Uuid
  matchId           String?       @unique @db.Uuid
  placeId           String?       @db.Uuid
  companyOrgId      String        @db.Uuid
  vendorOrgId       String        @db.Uuid
  startsAt          DateTime
  endsAt            DateTime
  timeZone          String        @default("UTC")
  durationMinutes   Int
  mode              MeetingMode   @default(VIRTUAL)
  venue             String?
  virtualDetails    Json          @default("{}")
  matchScore        Float?
  objectives        String?
  status            MeetingStatus @default(PROPOSED)
  cancellationReason String?
  idempotencyKey    String        @unique
  version           Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  scheduleVersion ScheduleVersion?        @relation(fields: [scheduleVersionId], references: [id])
  slot            MeetingSlot?            @relation(fields: [slotId], references: [id])
  match           Match?                  @relation(fields: [matchId], references: [id])
  place           Place?                  @relation(fields: [placeId], references: [id])
  companyOrg      Organization            @relation("MeetingCompany", fields: [companyOrgId], references: [id])
  vendorOrg       Organization            @relation("MeetingVendor", fields: [vendorOrgId], references: [id])
  participants    MeetingParticipant[]
  confirmations   MeetingConfirmation[]
  statusHistory   MeetingStatusHistory[]
  feedbacks       MeetingFeedback[]
  followUps       FollowUpAction[]
  rescheduleHistory MeetingReschedule[]
  meetingRequest  MeetingRequest?

  @@index([companyOrgId, startsAt])
  @@index([vendorOrgId, startsAt])
  @@index([status, startsAt])
  @@index([scheduleVersionId])
  @@index([placeId, startsAt, endsAt])
  @@map("meetings")
}

model MeetingParticipant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId String   @db.Uuid
  userId    String   @db.Uuid
  roleLabel String?
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_participants")
}

model MeetingConfirmation {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId String             @db.Uuid
  userId    String             @db.Uuid
  status    ConfirmationStatus @default(PENDING)
  note      String?
  respondedAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@map("meeting_confirmations")
}

model MeetingStatusHistory {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId  String         @db.Uuid
  fromStatus MeetingStatus?
  toStatus   MeetingStatus
  reason     String?
  actorId    String?        @db.Uuid
  createdAt  DateTime       @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
  @@map("meeting_status_history")
}

model MeetingReschedule {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId    String   @db.Uuid
  previousStartsAt DateTime
  previousEndsAt   DateTime
  newStartsAt  DateTime
  newEndsAt    DateTime
  reason       String
  actorId      String?  @db.Uuid
  createdAt    DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_reschedules")
}

// Occupancy rows used with exclusion constraints (raw SQL migration)
model MeetingOccupancy {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId      String   @db.Uuid
  participantKey String
  // stored as tstzrange via raw SQL; Prisma keeps scalar bounds for ORM access
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime @default(now())

  @@unique([meetingId, participantKey])
  @@index([participantKey, startsAt, endsAt])
  @@map("meeting_occupancies")
}

// ─── Feedback & Follow-ups ───────────────────────────────────────────────────

model MeetingFeedback {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId            String          @db.Uuid
  organizationId       String          @db.Uuid
  reviewerUserId       String          @db.Uuid
  attendanceConfirmed  Boolean
  meetingQuality       Int?
  relevance            Int?
  businessPotential    Int?
  communicationQuality Int?
  interestLevel        Int?
  followUpRequired     Boolean         @default(false)
  followUpDate         DateTime?
  outcome              FeedbackOutcome
  outcomeCustom        String?
  comments             String?
  isConfidential       Boolean         @default(true)
  revision             Int             @default(1)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  meeting      Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  reviewer     User         @relation(fields: [reviewerUserId], references: [id])

  @@unique([meetingId, organizationId])
  @@index([organizationId])
  @@map("meeting_feedbacks")
}

model FollowUpAction {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId      String?   @db.Uuid
  organizationId String    @db.Uuid
  title          String
  description    String?
  dueAt          DateTime?
  completedAt    DateTime?
  assigneeId     String?   @db.Uuid
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  meeting      Meeting?     @relation(fields: [meetingId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  assignee     User?        @relation("FollowUpAssignee", fields: [assigneeId], references: [id])
  createdBy    User         @relation("FollowUpCreator", fields: [createdById], references: [id])

  @@index([organizationId, dueAt])
  @@map("follow_up_actions")
}

// ─── Documents ───────────────────────────────────────────────────────────────

model Document {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @db.Uuid
  uploadedById   String?            @db.Uuid
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  checksumSha256 String?
  scanStatus     DocumentScanStatus @default(PENDING)
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("documents")
}

// ─── Notifications / Outbox / Jobs ───────────────────────────────────────────

model NotificationEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateCode   String
  templateVersion Int     @default(1)
  recipientEmail String
  recipientUserId String? @db.Uuid
  payload        Json
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  deliveries NotificationDelivery[]

  @@map("notification_events")
}

model NotificationDelivery {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String             @db.Uuid
  status    NotificationStatus @default(QUEUED)
  provider  String?
  providerResponse Json        @default("{}")
  attempt   Int                @default(0)
  sentAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  event NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@map("notification_deliveries")
}

model OutboxEvent {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String
  aggregateId  String
  eventType    String
  payload      Json
  idempotencyKey String     @unique
  status       OutboxStatus @default(PENDING)
  attempts     Int          @default(0)
  lastError    String?
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, createdAt])
  @@map("outbox_events")
}

model JobExecutionRecord {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobType        String
  queueName      String
  idempotencyKey String    @unique
  status         JobStatus @default(QUEUED)
  payload        Json
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lastError      String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, jobType])
  @@index([queueName, status])
  @@map("job_execution_records")
}

// ─── System ──────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  requestId  String?
  outcome    String
  before     Json?
  after      Json?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("system_settings")
}

model FeatureFlag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("feature_flags")
}

model IntegrationHealthEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  integration  String
  status       String
  latencyMs    Int?
  errorMessage String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([integration, createdAt])
  @@map("integration_health_events")
}

model EmailTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String
  version   Int
  subject   String
  bodyHtml  String
  bodyText  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([code, version])
  @@map("email_templates")
}

// ─── Filters (admin-managed tag taxonomies for forms + matching) ─────────────

model FilterDimension {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  /// Where submitted values land on the profile: categories | preferredCategories |
  /// capabilities | industry | regions | commercialTags
  profileKey  String   @default("categories")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags FilterTag[]

  @@index([isActive, sortOrder])
  @@map("filter_dimensions")
}

model FilterTag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dimensionId String   @db.Uuid
  value       String
  label       String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dimension   FilterDimension    @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  mappingsFrom FilterTagMapping[] @relation("MappingFrom")
  mappingsTo   FilterTagMapping[] @relation("MappingTo")

  @@unique([dimensionId, value])
  @@index([dimensionId, isActive, sortOrder])
  @@map("filter_tags")
}

model FilterTagMapping {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromTagId      String   @db.Uuid
  toTagId        String   @db.Uuid
  bidirectional  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fromTag FilterTag @relation("MappingFrom", fields: [fromTagId], references: [id], onDelete: Cascade)
  toTag   FilterTag @relation("MappingTo", fields: [toTagId], references: [id], onDelete: Cascade)

  @@unique([fromTagId, toTagId])
  @@index([toTagId])
  @@map("filter_tag_mappings")
}
