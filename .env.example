# Application
NODE_ENV=development
APP_NAME=event-matchmaking
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://em:em_secret@localhost:5433/event_matchmaking?schema=public
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://em:em_secret@localhost:5672
RABBITMQ_EXCHANGE=em.events
RABBITMQ_PREFETCH=10

# Auth / Sessions
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12
INVITATION_TTL_DAYS=7
SESSION_COOKIE_NAME=em_session

# CORS
CORS_ORIGINS=http://localhost:3000

# Email adapter (console | smtp | sendgrid)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=

# Object storage (local | s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# AI providers (disabled by default)
AI_ENABLED=false
AI_PRIMARY_PROVIDER=none
AI_SECONDARY_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_RETRIES=2

# Feature flags / ops
FEATURE_SEMANTIC_SEARCH=false
BACKUP_RETENTION_DAYS=30
RPO_HOURS=24
RTO_HOURS=4
