# =============================================================================
# Local development (docker compose for Postgres/Redis/RabbitMQ)
# For Railway production values, see docs/DEPLOYMENT.md
# =============================================================================

# Application
NODE_ENV=development
APP_NAME=event-matchmaking
APP_URL=https://refreshing-youthfulness-production-1f88.up.railway.app
API_URL=https://event-matchmaking-production.up.railway.app
API_PORT=4000
LOG_LEVEL=info

# Database — local Compose (host port 5433) OR Railway public URL
DATABASE_URL=postgresql://em:em_secret@localhost:5433/event_matchmaking?schema=public
DATABASE_POOL_SIZE=10

# Redis / RabbitMQ (local Compose)
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://em:em_secret@localhost:5672
RABBITMQ_EXCHANGE=em.events
RABBITMQ_PREFETCH=10

# Auth / Sessions
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12
INVITATION_TTL_DAYS=7
SESSION_COOKIE_NAME=em_session

# CORS (comma-separated origins)
CORS_ORIGINS=https://refreshing-youthfulness-production-1f88.up.railway.app

# Seed admin (optional overrides)
# ADMIN_EMAIL=info@vedha.ae
# ADMIN_PASSWORD=Vedha1002

# Frontend (apps/web) — set for local + Railway build
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Email / storage / AI / ops: configure in Admin → System Settings
# (not managed via .env)
