# =============================================================================
# Railway service: WEB  (root Dockerfile + SERVICE_TYPE=web → apps/web)
# =============================================================================

# --- Required (also enable "Available at Build Time" on Railway) ---
SERVICE_TYPE=web

# --- Required (runtime) ---
NODE_ENV=production
# PORT is injected by Railway for public services — do not hardcode unless needed
# PORT=3000

# --- Required (BUILD-TIME) ---
# Set as a Docker build ARG / Railway "Build variable":
#   Variables → mark available at build time, OR pass as Docker ARG
NEXT_PUBLIC_API_URL=https://YOUR_API_DOMAIN/api/v1

# Web does NOT need: DATABASE_URL, REDIS_URL, RABBITMQ_URL, JWT_*
