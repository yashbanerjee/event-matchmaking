# =============================================================================
# Railway service: WORKER  (root Dockerfile + SERVICE_TYPE=worker → apps/worker)
# =============================================================================

# --- Required (also enable "Available at Build Time" on Railway) ---
SERVICE_TYPE=worker

# --- Required ---
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
RABBITMQ_URL=${{RabbitMQ.URL}}

# --- Recommended ---
LOG_LEVEL=info
RABBITMQ_PREFETCH=10
EMAIL_PROVIDER=console

# Worker does NOT need: JWT_*, REDIS_URL, APP_URL, API_URL, CORS_ORIGINS, PORT
