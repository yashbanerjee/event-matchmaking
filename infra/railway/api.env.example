# =============================================================================
# Railway service: API  (root Dockerfile + SERVICE_TYPE=api → apps/api)
# =============================================================================

# --- Required (also enable "Available at Build Time" on Railway) ---
SERVICE_TYPE=api

# --- Required ---
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
RABBITMQ_URL=${{RabbitMQ.URL}}
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_SECRET
APP_URL=https://YOUR_WEB_DOMAIN
API_URL=https://YOUR_API_DOMAIN
CORS_ORIGINS=https://YOUR_WEB_DOMAIN

# --- Recommended ---
APP_NAME=event-matchmaking
LOG_LEVEL=info
RABBITMQ_EXCHANGE=em.events
RABBITMQ_PREFETCH=10
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12
INVITATION_TTL_DAYS=7
SESSION_COOKIE_NAME=em_session
DATABASE_POOL_SIZE=10

# --- Optional (Railway sets PORT automatically for public services) ---
# PORT=4000
# API_PORT=4000

# Email / storage / AI / ops → configure in Admin → System Settings (not required here)
