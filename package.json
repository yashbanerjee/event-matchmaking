{
  "name": "event-matchmaking",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise company & vendor matchmaking and meeting management platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build -w @em/shared && npm run build -w @em/domain",
    "build:api": "npm run build:packages && npm run prisma:generate && npm run build -w @em/api",
    "build:worker": "npm run build:packages && npm run prisma:generate && npm run build -w @em/worker",
    "build:web": "npm run build -w @em/shared && npm run build -w @em/web",
    "dev:api": "npm run start:dev -w @em/api",
    "dev:worker": "npm run start:dev -w @em/worker",
    "dev:web": "npm run dev -w @em/web",
    "build:service": "node scripts/build-by-type.mjs",
    "start:service": "node scripts/start-by-type.mjs",
    "start:api": "node scripts/start-by-type.mjs api",
    "start:worker": "node scripts/start-by-type.mjs worker",
    "start:web": "node scripts/start-by-type.mjs web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test -w @em/domain && npm run test -w @em/api --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:ethara": "tsx prisma/run-ethara-demo-seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.13.10",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcrypt": "^5.1.1"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
